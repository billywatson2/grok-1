# Copy to .env (same directory) and fill in real values. .env is gitignored --
# never commit a key. Anything already set in the environment wins over this file.
#
#     cp .env.example .env
#     $EDITOR .env

# --- Groq: fast cloud inference on their hardware ---------------------------
# Used by:
#   * the arena's "groq-llama" contestant (appears once this is set)
#   * the playground with:  python serve.py --backend groq
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=

# Any model id from https://api.groq.com/openai/v1/models
# NOTE: Groq retired llama-3.1-8b-instant and llama-3.3-70b-versatile on
# 2026-08-16. Current ids look like these:
#   openai/gpt-oss-120b    best quality
#   openai/gpt-oss-20b     fastest
# List what your key can use:
#   curl -s -H "Authorization: Bearer $GROQ_API_KEY" \
#     https://api.groq.com/openai/v1/models | grep -o '"id": *"[^"]*"'
GROQ_MODEL=openai/gpt-oss-120b

# Only change this to point at a proxy or an OpenAI-compatible host
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- E2B: throwaway cloud sandboxes ----------------------------------------
# Used by examples/groq_code_interpreter.py to run the code the model writes.
# (The Arena sandbox also sets E2B_SANDBOX_ID / E2B_TEMPLATE_ID for its own
# bookkeeping; this key is what spawning a new sandbox needs.)
# Get a key: https://e2b.dev/dashboard
E2B_API_KEY=

# --- optional: lock down the arena when it is reachable from other devices ---
# ARENA_TOKEN=some-shared-secret
